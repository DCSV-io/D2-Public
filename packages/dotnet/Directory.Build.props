<Project>
  <!--
    Packaging properties for the public package tree. They apply to every
    .csproj under packages/dotnet/. The file imports the Directory.Build.props
    above this tree for the dual roots, the target framework and the default
    StyleCop settings, then overrides StyleCop with the Apache header stamp.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>DCSV</Authors>
    <Company>DCSV</Company>
    <Product>D2</Product>
    <RepositoryUrl>https://github.com/dcsv-io/d2-public</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dcsv-io/d2-public</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(D2PublicRoot)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Dual StyleCop: remove the proprietary-license settings of the stylecop.json
       above this tree; StyleCop discovers its settings by a physical path that
       ends in stylecop.json (Link alone is not enough). The public tree uses the
       Apache stamp at packages/dotnet/stylecop.json (mirrored from the
       stylecop.public.json at the root of the public tree, for export
       clarity). -->
  <ItemGroup>
    <AdditionalFiles Remove="$(D2RepoRoot)stylecop.json" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
