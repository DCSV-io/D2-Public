<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Auth.ProtocolAudiences.SourceGen</RootNamespace>

    <!--
      A Roslyn analyzer or source generator must target netstandard2.0,
      because Roslyn runs inside the .NET Framework or .NET Core compilation
      host. This overrides the net10.0 target of Directory.Build.props.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- Mark this as a Roslyn analyzer/generator component for tooling. -->
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- Enable RS1035, which bans APIs an analyzer must not call, such as file and environment access. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- This project is only an analyzer, so its build output is not packed as a library. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

  </PropertyGroup>

  <ItemGroup>
    <!--
      Compile in the shared source-gen scaffolding (polyfills, the EmitDiagnostic
      record, LoadResult<TSpec> and SpecFile). The Link metadata groups the
      included files under a virtual "Shared" folder in IDE views.
    -->
    <Compile Include="$(D2SourceGenSharedRoot)**\*.cs">
      <Link>Shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" keeps the analyzer dll with this project and stops
      these references propagating to a project that references it.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- System.Text.Json bundled into the analyzer dll via GeneratePathProperty. -->
    <PackageReference Include="System.Text.Json" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Bundle System.Text.Json into the analyzer output so Roslyn's host can load it. -->
  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>
</Project>
