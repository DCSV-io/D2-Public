<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.PasswordHashing</RootNamespace>
  </PropertyGroup>

  <!--
    DcsvIo.D2.PasswordHashing - portable Argon2id PHC hash and verify helpers.
    It references no Auth types. It depends on Result, Utilities and Konscious
    Argon2id.
  -->

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\result\core\DcsvIo.D2.Result.csproj" />
    <ProjectReference Include="..\utilities\DcsvIo.D2.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.2.10</Version>
    <PackageId>DcsvIo.D2.PasswordHashing</PackageId>
    <Description>Portable Argon2id PHC password hashing and verification for D2 consumers.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
