<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.29</Version>
    <RootNamespace>DcsvIo.D2.Validation.Abstractions</RootNamespace>

    <!--
      Write the FieldConstraints.g.cs and Taxonomy.g.cs files that SrcGen emits
      (driven by the validation/source-gen analyzer referenced below) to
      <project-dir>/Generated/. Git tracks the directory, so pull request
      reviewers see codegen diffs without a local build.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline gives the in-memory compiler the same content that
      it writes to disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob also includes the on-disk copy and the
      build fails with duplicate-definition errors (CS0101 and CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    DI-free interface and shared-catalog library. A project can take a
    ProjectReference here without pulling in a DI container, phone-number
    library, or geo catalog data. The surface is the email, phone and
    postal-code validator contracts plus the shared field-constraints catalog
    (the emitted FieldConstraints constants and the NamePrefix, NameSuffix and
    BiologicalSex taxonomy enums). It is the lowest shared vocabulary layer.

    The project has no Microsoft.Extensions.DependencyInjection reference and
    no implementation code. Implementations live in DcsvIo.D2.Validation.
  -->
  <ItemGroup>
    <!--
      DcsvIo.D2.Result - the email, phone and postal-code validator interfaces
      return D2Result<string>, which reports Success or ValidationFailed and
      field-level InputErrors in the standard envelope.
    -->
    <ProjectReference Include="..\..\result\core\DcsvIo.D2.Result.csproj" />
    <!--
      DcsvIo.D2.Geo.Abstractions - CountryCode is used by IPhoneValidator
      (defaultRegion) and IPostalCodeValidator (countryCode) to scope
      national-format interpretation and country-specific format rules.
    -->
    <ProjectReference Include="..\..\geo\abstractions\DcsvIo.D2.Geo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Source generator that emits the FieldConstraints constants and the taxonomy
      enums. The spec file is passed in through AdditionalFiles so the SrcGen can
      read it at codegen time. Single-target dispatch on
      DcsvIo.D2.Validation.Abstractions.
    -->
    <ProjectReference Include="..\source-gen\DcsvIo.D2.Validation.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(D2PublicContractsRoot)validation\field-constraints.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata: per-package semver and NuGet identity. -->
  <PropertyGroup>
    <PackageId>DcsvIo.D2.Validation.Abstractions</PackageId>
    <Description>Validation contract surface for D2 - email, phone, and postal-code validator interfaces, shared field-length bounds, and the name/sex taxonomy enums.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
