<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Handler</RootNamespace>
  </PropertyGroup>

  <!--
    BaseHandler, HandlerContext, HandlerTelemetry and AddD2Handler. The runtime
    piece that every handler inherits - CQRS handlers, repo handlers,
    messaging consumers, scheduled jobs and any other handler-shaped operation.
    Emits the OTel metrics invoked, succeeded, failed and duration_ms on every
    call, plus a per-call span through System.Diagnostics.ActivitySource.

    Universal try/catch shape: ExecuteAsync exceptions become
    D2Result.UnhandledException when HandleAsync returns. An
    OperationCanceledException from a cancellation the caller requested becomes
    D2Result.Canceled, and any other OperationCanceledException becomes
    D2Result.ServiceUnavailable. RunCorePipelineAsync exposes the captured
    exception so a subclass can remap EF/PG-specific exceptions to typed
    D2Result failure codes.
  -->

  <ItemGroup>
    <ProjectReference Include="..\abstractions\DcsvIo.D2.Handler.Abstractions.csproj" />
    <ProjectReference Include="..\..\context\abstractions\DcsvIo.D2.Context.Abstractions.csproj" />
    <ProjectReference Include="..\..\result\core\DcsvIo.D2.Result.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
    <!--
      One assembly granted below is a runtime assembly, not a test one. The
      README's Require/Elevate section records the exception.
    -->
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <PackageId>DcsvIo.D2.Handler</PackageId>
    <Description>BaseHandler for D2 - the abstract base every handler inherits, providing scope pre-checks, OpenTelemetry activity and metrics, log scope, and a universal try/catch.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
