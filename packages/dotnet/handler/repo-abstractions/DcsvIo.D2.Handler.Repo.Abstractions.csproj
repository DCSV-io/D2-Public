<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Handler.Repo.Abstractions</RootNamespace>
  </PropertyGroup>

  <!--
    Vocabulary for repo handlers - the types for discriminating
    database-specific failures (unique violation, FK violation, deadlock,
    concurrency conflict, connection failure, etc.).

    Pure abstractions: no EF Core, no Npgsql, no provider dependencies. It
    contains the DbFailureKind enum and the IDbExceptionClassifier interface
    (provider implementations are in sibling packages like
    DcsvIo.D2.Handler.Repo.Postgres), plus extension factories on D2Result, so
    handlers can emit typed DB failures with D2Result.UniqueViolation() and
    callers can discriminate them with result.IsDbDeadlock and so on, in
    parallel with the built-in semantic factories on the result lib.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\result\core\DcsvIo.D2.Result.csproj" />
    <ProjectReference Include="..\..\i18n\core\DcsvIo.D2.I18n.csproj" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <Version>0.1.19</Version>
    <PackageId>DcsvIo.D2.Handler.Repo.Abstractions</PackageId>
    <Description>Vocabulary for repo-flavored D2 handlers - the database-failure discrimination contract (unique, FK, deadlock, concurrency, connection), zero infrastructure dependencies.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
