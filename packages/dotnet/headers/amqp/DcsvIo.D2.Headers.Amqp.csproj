<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.7</Version>
    <RootNamespace>DcsvIo.D2.Headers.Amqp</RootNamespace>

    <!-- Emit SourceGen output to <project-dir>/Generated/. Git tracks this
         directory, so pull request reviewers see codegen diffs without a
         local build. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The SourceGen pipeline gives the in-memory compiler the same content that
      it writes to disk under Generated/. Without this Remove, the SDK-default
      <Compile Include="**/*.cs" /> glob also picks up the on-disk copy, and the
      build fails with duplicate-definition errors (CS0101 / CS0111). See:
      https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#compilergeneratedfilesoutputpath
    -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" />
  </ItemGroup>

  <!--
    AMQP-applicable D2 wire-protocol headers. Codegen-emitted from
    contracts/headers/headers.spec.json filtered to entries whose applicability
    array contains "amqp" (covers AMQP-only entries AND cross-transport entries).
    Zero runtime dependencies.
  -->

  <ItemGroup>
    <ProjectReference Include="..\source-gen\DcsvIo.D2.Headers.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(D2PublicContractsRoot)headers\headers.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <PackageId>DcsvIo.D2.Headers.Amqp</PackageId>
    <Description>D2 wire-protocol header constants applicable to the AMQP transport, code-generated from the shared headers spec.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
