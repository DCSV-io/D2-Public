<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Pagination.ErrorCodes.SourceGen</RootNamespace>

    <!--
      Roslyn analyzers and source generators must target netstandard2.0
      because Roslyn itself runs in the host's .NET Framework or .NET Core
      compilation environment. This overrides the net10.0 target that
      Directory.Build.props sets.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- Mark this as a Roslyn analyzer/generator component for tooling. -->
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- Enable RS1035, which bans APIs an analyzer must not call, such as file and environment access. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Do not ship this as a library to consumers; it is only an analyzer. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

  </PropertyGroup>

  <ItemGroup>
    <!--
      Pull in the shared source-gen scaffolding (polyfills + EmitDiagnostic
      record + LoadResult<TSpec> + SpecFile). The Link metadata groups the
      included files under a virtual "Shared" folder in IDE views.
    -->
    <Compile Include="$(D2SourceGenSharedRoot)**\*.cs">
      <Link>Shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!--
      Pull in the unified error-codes generation engine (entry model + loader
      + constants/failures emitters + CatalogConfig + the D2ERC* engine
      diagnostics). One engine drives every catalog shell; this shell supplies
      only its CatalogConfig and its analyzer identity.
    -->
    <Compile Include="$(D2ErrorCodesEmitRoot)**\*.cs">
      <Link>ErrorCodesEmit\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" so the analyzer dll travels with this project but
      does NOT propagate to projects that reference it.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- System.Text.Json bundled into the analyzer dll via GeneratePathProperty. -->
    <PackageReference Include="System.Text.Json" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Bundle System.Text.Json into the analyzer output so Roslyn's host can load it. -->
  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>
</Project>
