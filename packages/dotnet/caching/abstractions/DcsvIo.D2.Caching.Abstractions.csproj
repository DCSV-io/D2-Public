<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.5.12</Version>
    <RootNamespace>DcsvIo.D2.Caching</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Every cache op returns D2Result<T> so its results compose with the rest
      of the codebase's errors-as-values pattern; tier failures return PartialSuccess
      (writes) or NotFound / SomeFound (reads), and each of those reports
      Success false, so a check of Failed alone treats a write that reached
      one tier as not done.

      Utilities supplies Falsey(), the emptiness check this codebase requires
      for null, empty, whitespace and Guid.Empty values. It declares no runtime
      NuGet package, so the dependency closure of these abstractions gains
      only JetBrains.Annotations, a compile-time attributes package.
    -->
    <ProjectReference Include="..\..\result\core\DcsvIo.D2.Result.csproj" />
    <ProjectReference Include="..\..\i18n\abstractions\DcsvIo.D2.I18n.Abstractions.csproj" />
    <ProjectReference Include="..\..\i18n\keys\DcsvIo.D2.I18n.Keys.csproj" />
    <ProjectReference Include="..\..\utilities\DcsvIo.D2.Utilities.csproj" />
  </ItemGroup>

  <!-- Publish metadata (per-package semver + NuGet identity). -->
  <PropertyGroup>
    <PackageId>DcsvIo.D2.Caching.Abstractions</PackageId>
    <Description>Shared abstractions for the D2 cache stack - the ILocalCache / IDistributedCache / ITieredCache marker interfaces and the invalidation backplane contract.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
