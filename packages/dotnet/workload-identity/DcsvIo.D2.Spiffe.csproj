<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DcsvIo.D2.Spiffe</RootNamespace>
  </PropertyGroup>

  <!--
    DcsvIo.D2.Spiffe - the single home for the SPIFFE workload-identity
    grammar (spiffe://d2.internal/workload/<service>). A pure, leaf-tier value
    object that parses, validates and emits the SPIFFE subject-alternative-name
    that a leaf certificate contains and a peer validator checks. The grammar
    lives only here, so the SPIFFE format has a single source and no parser is
    duplicated.

    Leaf-tier: the project references only DcsvIo.D2.Result (for the D2Result
    generic ValidationFailed that the value object returns), which transitively
    brings the ErrorCategory and TK message vocabulary, and DcsvIo.D2.Utilities.
    It has no AspNetCore, Kestrel, X.509 or service-domain dependency. The value
    object works on the SAN string; extracting it from the certificate is the
    validator's job.

    net10.0, Nullable, ImplicitUsings, StyleCop, TreatWarningsAsErrors and
    GenerateDocumentationFile are inherited from Directory.Build.props.
  -->

  <ItemGroup>
    <!--
      DcsvIo.D2.Result - D2Result<T> and the generic ValidationFailed semantic
      factory that the value object returns on a malformed identity.
      Transitively re-exposes ErrorCategory and the TK message catalog.
    -->
    <ProjectReference Include="..\result\core\DcsvIo.D2.Result.csproj" />
    <!--
      DcsvIo.D2.Utilities - the ToNullIfEmpty() and ThrowIfFalsey() guards used
      by the value object's smart constructors.
    -->
    <ProjectReference Include="..\utilities\DcsvIo.D2.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DcsvIo.D2.Tests" />
  </ItemGroup>

  <!-- Publish metadata: per-package semver and NuGet identity. -->
  <PropertyGroup>
    <Version>0.1.18</Version>
    <PackageId>DcsvIo.D2.Spiffe</PackageId>
    <Description>SPIFFE workload-identity value object and peer validator for D2 mTLS - the subject-alternative-name a leaf certificate carries and the trust-domain grammar.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
